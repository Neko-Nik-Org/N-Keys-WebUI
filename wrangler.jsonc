{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "n-keys-ui",
  "compatibility_date": "2024-05-20",
  "pages_build_output_dir": ".vercel/output/static",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}